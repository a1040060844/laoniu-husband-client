; Engine configuration file
; Godot 4.x PoC for the WeChat mini game migration.

config_version=5

[application]
config/name="老妞大人宠宠我 - Godot PoC"
run/main_scene="res://scenes/main.tscn"

[autoload]
ApiClient="*res://src/api_client.gd"
GameState="*res://src/game_state.gd"
AssetManifest="*res://src/asset_manifest.gd"
CloudAssetManager="*res://src/cloud_asset_manager.gd"
AudioManager="*res://src/audio_manager.gd"
AssetBootstrap="*res://src/asset_bootstrap.gd"
LoginVisualOverlay="*res://src/login_visual_overlay.gd"
LoginAnimationOverlay="*res://src/login_animation_overlay.gd"
LoginVisualParity="*res://src/login_visual_parity.gd"
LoginVisualEffects="*res://src/login_visual_effects.gd"
RoleVisualOverlay="*res://src/role_visual_overlay.gd"
RoleVisualParity="*res://src/role_visual_parity.gd"
RolePreviewController="*res://src/role_preview_controller.gd"
BenefitVisualOverlay="*res://src/benefit_visual_overlay.gd"
BenefitVisualParity="*res://src/benefit_visual_parity.gd"
BenefitReturnGesture="*res://src/benefit_return_gesture.gd"
TaskVisualOverlay="*res://src/task_visual_overlay.gd"
TaskVisualParity="*res://src/task_visual_parity.gd"
TaskVisualEffects="*res://src/task_visual_effects.gd"
TaskSubmitModal="*res://src/task_submit_modal.gd"
TaskReturnGesture="*res://src/task_return_gesture.gd"
HusbandAudioController="*res://src/husband_audio_controller.gd"
HusbandQuickControls="*res://src/husband_quick_controls.gd"
InputDiagnostics="*res://src/input_diagnostics.gd"
DebugWindowResizer="*res://src/debug_window_resizer.gd"
ValidationDebugOverlay="*res://src/validation_debug_overlay.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"

[audio]
driver/enable_input=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[laoniu]
assets/manifest_url="https://www.laoniulaoge.cn/game-assets/manifest.json"
