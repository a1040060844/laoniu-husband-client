; Engine configuration file.
; Godot 4.x PoC for the WeChat mini game migration.

config_version=5

[application]
config/name="老妞大人宠宠我 - Godot PoC"
run/main_scene="res://scenes/main.tscn"

[autoload]
ApiClient="*res://src/api_client.gd"
GameState="*res://src/game_state.gd"
AssetManifest="*res://src/asset_manifest.gd"
CloudAssetManager="*res://src/cloud_asset_manager.gd"
AudioManager="*res://src/audio_manager.gd"
AssetBootstrap="*res://src/asset_bootstrap.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"

[audio]
driver/enable_input=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[laoniu]
assets/manifest_url="https://www.laoniulaoge.cn/game-assets/manifest.json"
