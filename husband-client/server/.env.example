NODE_ENV=development
HOST=0.0.0.0
PORT=4180

# Keep database files outside frontend public/dist.
DATABASE_PATH=./data/laoniu.sqlite
BACKUP_DIR=./data/backups
UPLOAD_DIR=./uploads

# Optional when the API is served separately from the Vite dev server.
CORS_ORIGIN=http://localhost:5174
CLIENT_DIST_DIR=../dist
JSON_LIMIT=8mb
BACKUP_RETENTION=10
