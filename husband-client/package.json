{
  "name": "laoniu-husband-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:login-sprites": "node scripts/audit-login-sprites.mjs",
    "prepare:audio": "node scripts/prepare-audio.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "server:build": "npm run build --prefix server",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "start": "node server.mjs",
    "check": "npm test && npm run audit:login-sprites && tsc -b && vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "puppeteer-core": "^25.0.4"
  }
}
